{
  "properties": {
    "roleName": "VM Health Diagnostic Reader",
    "description": "Read-only runtime permissions for VM Health Diagnostic V2. Includes VM/runtime/extension reads, Azure Monitor metrics and Activity Log, active alerts, Resource Health current/history, managed disks, NICs, effective routes/NSGs, DCRs, Update Manager assessment, and Azure Backup protected-item/status reads. No VM, disk, network, patch, backup, or monitoring configuration is modified.",
